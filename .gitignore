# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/appli/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.storage/

# local editor settings
.vscode/

# appli/ — artefacts régénérés par Capacitor (voir appli/CAPACITOR.md) :
# bundle web produit par `npm run build:www` et projets natifs produits par
# `npx cap add ios|android`. Jamais versionnés.
/appli/www/
/appli/ios/
/appli/android/

# captures d'écran de vérification de développement (Playwright) — artefacts
# de construction, pas du code source ; ne doivent jamais gonfler l'historique
# du dépôt
/artifacts/
