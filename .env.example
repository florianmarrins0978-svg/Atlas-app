# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne JAMAIS committer un .env rempli — voir .gitignore (déjà exclu).

# --- Obligatoire, toujours ---
DATABASE_URL=postgresql://user:password@host:5432/atlas

# --- Authentification (Auth.js) ---
# Obligatoire en production (32+ octets aléatoires). En développement, une
# valeur par défaut interne est utilisée si absente — jamais en production.
AUTH_SECRET=

# --- Stockage de fichiers ---
# "local" (développement/test uniquement, refusé en production) ou "s3"
STORAGE_PROVIDER=local
# Requis uniquement si STORAGE_PROVIDER=s3 :
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Limitation de débit ---
# Obligatoire en production (le magasin en mémoire n'est jamais autorisé).
REDIS_URL=

# --- Purge planifiée ---
# Obligatoire en production, 16 caractères minimum.
CRON_SECRET=

# Connexions simultanées à PostgreSQL, par instance (10 par défaut). À régler
# le jour où plusieurs instances servent beaucoup d'artisans : (instances × max)
# doit rester sous la limite de connexions de la base.
DATABASE_POOL_MAX=

# --- IA ---
# **Poser une clé suffit à brancher l'IA.** Sans clé, tout reste déterministe :
# aucun appel réseau, aucune donnée qui sort. Avec ANTHROPIC_API_KEY, Anthropic
# rédige ; avec OPENAI_API_KEY, OpenAI transcrit la dictée (Anthropic ne prend
# pas d'audio) — et rédige si Anthropic n'est pas là.
#
# Une variable VIDE vaut une variable absente : `LLM_PROVIDER=` ne force rien.
# Ne renseigner les deux lignes ci-dessous que pour aller CONTRE les clés
# présentes — typiquement `LLM_PROVIDER=dev` pour couper l'IA sans retirer la
# clé. Pour vérifier l'état réel : `npm run verifier:ia`.
#
# En production, ces deux variables sont obligatoires et vérifiées au
# démarrage : « dev », un nom inconnu ou une clé absente font échouer le
# lancement plutôt que de servir des textes fabriqués à de vrais chantiers.
LLM_PROVIDER=
TRANSCRIPTION_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# --- Observabilité ---
# Optionnel à tout moment — sans valeur, Sentry ne fait rien (aucune requête
# réseau, aucune erreur).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
RELEASE_VERSION=
LOG_LEVEL=info
