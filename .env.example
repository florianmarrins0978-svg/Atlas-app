# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne JAMAIS committer un .env rempli — voir .gitignore (déjà exclu).

# --- Obligatoire, toujours ---
DATABASE_URL=postgresql://user:password@host:5432/atlas

# --- Authentification (Auth.js) ---
# Obligatoire en production (32+ octets aléatoires). En développement, une
# valeur par défaut interne est utilisée si absente — jamais en production.
AUTH_SECRET=

# **À POSER SUR TOUT DÉPLOIEMENT DERRIÈRE UN MANDATAIRE** — c'est-à-dire à peu
# près tous (audit du 23 août 2026, constat M7).
#
# Auth.js refuse par défaut de faire confiance à l'hôte annoncé par le
# navigateur : sans cette variable (ou sans AUTH_URL, l'adresse publique
# complète), CHAQUE CONNEXION SERA REFUSÉE en production, avec ce message dans
# le journal du serveur :
#
#     [auth][error] UntrustedHost: Host must be trusted.
#
# et l'artisan, lui, ne lit qu'« une erreur ». C'est un refus VOLONTAIRE, et il
# vaut mieux que l'inverse : jusqu'au 23 août 2026, `src/auth.ts` posait un
# `trustHost: true` inconditionnel qui accordait cette confiance en production
# sans que personne l'ait décidée — pendant que le dépôt affirmait le contraire.
#
# Le banc d'essai n'a rien à poser : le profil banc l'accorde déjà.
AUTH_TRUST_HOST=

# --- Déploiement réel (audit du 23 août 2026, constat M8) ---
#
# À poser à « production » sur une vraie mise en service. Sert UNIQUEMENT à
# refuser une configuration contradictoire : le profil banc d'essai
# (ATLAS_PROFIL / ATLAS_BANC_ESSAI) DÉSACTIVE la protection contre le CSRF des
# actions serveur, et n'a donc rien à faire sur une machine qui sert de vrais
# clients. Atlas refuse alors de démarrer, avec un message qui le dit.
#
# Facultatif : la contradiction se détecte déjà toute seule quand
# STORAGE_PROVIDER=s3 est posé en même temps que le profil banc — un banc n'a
# jamais de compartiment S3. Cette variable couvre l'hébergement qui n'en
# utiliserait pas.
ATLAS_DEPLOIEMENT=

# --- Stockage de fichiers ---
# "local" (développement/test uniquement, refusé en production) ou "s3"
STORAGE_PROVIDER=local
# Requis uniquement si STORAGE_PROVIDER=s3 :
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Limitation de débit ---
# Obligatoire en production (le magasin en mémoire n'est jamais autorisé).
REDIS_URL=

# --- Purge planifiée ---
# Obligatoire en production, 16 caractères minimum.
CRON_SECRET=

# Connexions simultanées à PostgreSQL, par instance (10 par défaut). À régler
# le jour où plusieurs instances servent beaucoup d'artisans : (instances × max)
# doit rester sous la limite de connexions de la base.
DATABASE_POOL_MAX=

# --- Mandataires de confiance (audit du 23 août 2026, constat C1) ---
#
# Combien de mandataires de CONFIANCE se trouvent devant Atlas. Vide ou 0 =
# aucun, et c'est le défaut SÛR.
#
# **Pourquoi ce réglage existe.** La limitation des tentatives de connexion se
# calait sur la première valeur de `x-forwarded-for` — un en-tête que celui qui
# frappe écrit lui-même. Il suffisait de le changer à chaque essai pour repartir
# d'un compteur neuf. Désormais, sans ce nombre, **aucune adresse transmise
# n'est crue** : le seuil par visiteur devient commun à tout le monde. Il
# protège encore, mais moins finement.
#
# À POSER EN PRODUCTION : le nombre de mandataires de confiance placés devant
# Atlas — 1 pour un hébergeur ordinaire, 2 si un CDN s'ajoute devant lui. Et
# s'assurer que ce mandataire ÉCRASE `x-forwarded-for` plutôt que d'y ajouter la
# valeur envoyée par le client.
#
# Ce que cela ne change PAS : la temporisation par compte (migration 0062) ne
# dépend d'aucun en-tête ni d'aucun service annexe. Elle tient sans ce réglage.
ATLAS_PROXY_SAUTS=

# --- IA ---
# **Poser une clé suffit à brancher l'IA.** Sans clé, tout reste déterministe :
# aucun appel réseau, aucune donnée qui sort. Avec ANTHROPIC_API_KEY, Anthropic
# rédige ; avec OPENAI_API_KEY, OpenAI transcrit la dictée (Anthropic ne prend
# pas d'audio) — et rédige si Anthropic n'est pas là.
#
# Une variable VIDE vaut une variable absente : `LLM_PROVIDER=` ne force rien.
# Ne renseigner les deux lignes ci-dessous que pour aller CONTRE les clés
# présentes — typiquement `LLM_PROVIDER=dev` pour couper l'IA sans retirer la
# clé. Pour vérifier l'état réel : `npm run verifier:ia`.
#
# En production, ces deux variables sont obligatoires et vérifiées au
# démarrage : « dev », un nom inconnu ou une clé absente font échouer le
# lancement plutôt que de servir des textes fabriqués à de vrais chantiers.
LLM_PROVIDER=
TRANSCRIPTION_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# --- Diagnostic végétal ---
# **Qui REGARDE les photos, à distinguer de qui rédige.** Sans valeur, c'est
# LLM_PROVIDER : votre configuration actuelle marche donc sans rien poser ici.
# Ces deux lignes existent pour qu'un moteur spécialisé puisse remplacer le
# généraliste sans reconstruire le module — et pour couper le diagnostic sans
# couper la dictée. VISION_MODELE remplace le nom de modèle qui était écrit en
# dur dans le fournisseur.
VISION_PROVIDER=
VISION_MODELE=

# Conservation des photos de diagnostic, en JOURS. `0` = ne jamais purger.
# Deux durées parce que les deux cas n'ont rien à voir : une photo prise en
# visite n'a plus d'utilité une fois le résultat rendu ; une photo versée au
# dossier d'un chantier est une pièce du dossier. Par défaut : 90 et 0.
PHOTOS_DIAGNOSTIC_RETENTION_JOURS=
PHOTOS_DIAGNOSTIC_RETENTION_JOURS_CHANTIER=

# --- Observabilité ---
# Optionnel à tout moment — sans valeur, Sentry ne fait rien (aucune requête
# réseau, aucune erreur).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
RELEASE_VERSION=
LOG_LEVEL=info
