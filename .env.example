# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne JAMAIS committer un .env rempli — voir .gitignore (déjà exclu).

# --- Obligatoire, toujours ---
DATABASE_URL=postgresql://user:password@host:5432/atlas

# --- Authentification (Auth.js) ---
# Obligatoire en production (32+ octets aléatoires). En développement, une
# valeur par défaut interne est utilisée si absente — jamais en production.
AUTH_SECRET=

# --- Stockage de fichiers ---
# "local" (développement/test uniquement, refusé en production) ou "s3"
STORAGE_PROVIDER=local
# Requis uniquement si STORAGE_PROVIDER=s3 :
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Limitation de débit ---
# Obligatoire en production (le magasin en mémoire n'est jamais autorisé).
REDIS_URL=

# --- Purge planifiée ---
# Obligatoire en production, 16 caractères minimum.
CRON_SECRET=

# --- IA ---
# "dev" (déterministe, sans appel réseau) par défaut : c'est le mode normal du
# banc d'essai, et la transcription y rend « [Transcription simulée — … ] ».
#
# REFUSÉ EN PRODUCTION. L'application ne démarre pas si l'un des deux vaut
# "dev", porte un nom de fournisseur inconnu, ou désigne un fournisseur sans sa
# clé — sinon un vrai chantier recevrait de faux textes sans que rien ne le
# signale. Voir src/server/env.ts et docs/A-FAIRE.md §1.
#
# Fournisseurs écrits et complets aujourd'hui : anthropic (raisonnement) et
# openai (transcription). Les autres noms sont acceptés par la configuration
# mais leur raccordement reste à écrire — voir docs/TRANSCRIPTION.md.
LLM_PROVIDER=dev               # anthropic | openai | gemini
TRANSCRIPTION_PROVIDER=dev     # openai | deepgram | google
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=

# --- Observabilité ---
# Optionnel à tout moment — sans valeur, Sentry ne fait rien (aucune requête
# réseau, aucune erreur).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
RELEASE_VERSION=
LOG_LEVEL=info
