{
  "name": "atlas-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "essai": "node scripts/essai.mjs",
    "essai:reinitialiser": "tsx src/server/db/seed.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verifier:memoire": "node scripts/verifier-memoire.mjs",
    "verifier:maquette": "node maquettes/verifier-atlas-origine.mjs && node maquettes/verifier-atlas-note-vocale.mjs && node maquettes/verifier-atlas-equipes.mjs && node maquettes/verifier-atlas-planning.mjs && node maquettes/verifier-atlas-facturer.mjs",
    "verifier:ia": "tsx scripts/verifier-ia.ts",
    "icones": "node scripts/generer-icones.mjs",
    "test": "tsx scripts/run-all-tests.ts",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "diagnostiquer:connexion": "tsx scripts/diagnostiquer-connexion.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "dev:setup": "npm run db:migrate:local && npm run db:seed:local",
    "db:migrate:local": "tsx --env-file=.env scripts/run-migrations.ts",
    "db:seed:local": "tsx --env-file=.env src/server/db/seed.ts",
    "verifier:avant-livraison": "tsx scripts/verifier-avant-livraison.ts",
    "verifier:connexion": "tsx scripts/verifier-connexion-avec-serveur.mts",
    "banc": "node scripts/banc.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@sentry/nextjs": "^10.68.0",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
